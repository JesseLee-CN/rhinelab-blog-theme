{
  "name": "example-blog",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/blog"
  ],
  "scripts": {
    "dev:blog": "npm run dev --workspace @example/blog",
    "dev:lab": "npm run generate:lab-content && vite --config vite.lab.config.ts --host 127.0.0.1",
    "dev:reference": "npm run generate:lab-content && vite --host 127.0.0.1",
    "dev": "npm run generate:lab-content && vite --config vite.lab.config.ts --host 127.0.0.1",
    "check:content": "node scripts/blog/check-content.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check:viewport": "node --experimental-strip-types scripts/check-viewport.mjs",
    "check:reader": "node --experimental-strip-types scripts/blog/check-reader.mjs",
    "test:reader": "node --experimental-strip-types --test scripts/reading/test-contract.mjs scripts/reading/test-controller.mjs scripts/reading/test-surface.mjs",
    "test:reader-e2e": "node scripts/reading/run-e2e.mjs",
    "build:reader-fixtures": "node scripts/reading/fixtures/build-fixture-site.mjs",
    "check:reader-content": "node --experimental-strip-types scripts/reading/verify-content.mjs",
    "check:render-updates": "node --experimental-strip-types scripts/check-render-updates.mjs",
    "check:motion-preferences": "node --experimental-strip-types scripts/check-motion-preferences.mjs",
    "build:performance": "node scripts/build-performance.mjs",
    "serve:performance": "node scripts/serve-performance.mjs",
    "check:model-precision": "node scripts/check-model-precision-review.mjs",
    "test:identity": "node --test scripts/auth/test-identity.mjs",
    "test:intro": "node --test scripts/auth/test-intro.mjs",
    "test:entry": "node scripts/auth/test-entry.mjs",
    "check:entry": "node scripts/auth/check-entry.mjs",
    "check:intro": "node scripts/auth/check-intro.mjs",
    "serve:review": "node scripts/auth/serve-review.mjs",
    "check:flow": "node scripts/auth/check-flow.mjs",
    "test:login-e2e": "node scripts/auth/run-login-improve-e2e.mjs",
    "check:artifacts": "node scripts/auth/check-artifacts.mjs",
    "package:auth": "node scripts/auth/package-auth.mjs",
    "package:pairing": "node scripts/auth/package-pairing.mjs",
    "test:packaging": "node --test scripts/auth/test-packaging.mjs",
    "bench:auth": "node scripts/auth/bench-auth.mjs",
    "test:blog": "node --test scripts/blog/test-content.mjs",
    "typecheck": "npm run generate:lab-content && tsc",
    "prepare:assets": "npm run generate:lab-content && node scripts/blog/prepare-assets.mjs",
    "generate:lab-content": "node scripts/blog/build-lab-content.mjs",
    "build:blog": "npm run prepare:assets && npm run build --workspace @example/blog",
    "build:lab": "npm run prepare:assets && vite build --config vite.lab.config.ts",
    "search:index": "node scripts/blog/search-index.mjs",
    "check:site": "node --experimental-strip-types scripts/blog/check-site.mjs",
    "check:account": "node scripts/blog/check-account.mjs",
    "build": "node scripts/blog/build-site.mjs",
    "release": "node scripts/blog/package-release.mjs",
    "preview": "node scripts/blog/preview.mjs",
    "review:mobile": "node scripts/serve-mobile-review.mjs",
    "format": "prettier --write src scripts apps/blog/src apps/blog/astro.config.mjs index.html lab package.json tsconfig.json vite.lab.config.ts"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "parse5": "7.3.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/three": "^0.183.0",
    "js-yaml": "^4.3.0",
    "pagefind": "1.5.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
