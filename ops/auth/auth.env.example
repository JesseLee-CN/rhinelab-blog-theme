# Sanitized template for the boot identity auth service. Copy to
# /etc/example-blog-auth/auth.env on the server (root-owned, 0600) and fill
# in real values. Never commit the filled file.
LAB_AUTH_ENV=production
LAB_AUTH_LISTEN=unix:/run/example-blog-auth/http.sock
LAB_AUTH_DB=/var/lib/example-blog-auth/auth.db
LAB_AUTH_ALLOWED_ORIGINS=https://example.com
# 32 random bytes, hex encoded (openssl rand -hex 32)
LAB_AUTH_CSRF_SECRET=REPLACE_WITH_64_HEX_CHARS

# Optional tuning (defaults shown)
# LAB_AUTH_PENDING_TTL=60s
# LAB_AUTH_FLOW_TTL=10m
# LAB_AUTH_ARGON_MEMORY_KIB=19456
# LAB_AUTH_ARGON_ITERATIONS=2
# LAB_AUTH_ARGON_PARALLELISM=1
# LAB_AUTH_SOURCE_RATE_PER_MIN=10
# LAB_AUTH_USERNAME_RATE=5

# Public registration (register-v1). Disabled unless set to 1/true. Enable only
# for an approved release; see services/lab-auth/README.md.
# LAB_AUTH_REGISTRATION_ENABLED=false
# LAB_AUTH_REGISTER_SOURCE_HOURLY=10
# LAB_AUTH_REGISTER_GLOBAL_DAILY=200
# LAB_AUTH_REGISTER_MAX_USERS=5000

# Account management API (/api/auth/admin/...). Disabled while empty: the routes
# answer 503 instead of exposing an unauthenticated surface. At least 32
# characters (openssl rand -hex 32). It is a bearer token, so treat it like a
# database password: server-side only, never in a browser or in Git.
# LAB_AUTH_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_CHARS
# LAB_AUTH_ADMIN_RATE=60
