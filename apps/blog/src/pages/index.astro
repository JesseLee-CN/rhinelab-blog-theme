---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, getPublishedPosts } from "../lib/content";

const posts = await getPublishedPosts();
const categories = [...new Set(posts.flatMap((post) => post.data.categories))];
---

<BaseLayout title="示例博客" description="用 Markdown 写作、Git 发布的个人博客，保留 RhineLabUI 三维档案入口。">
  <h1 class="page-title">最新文章</h1>
  {
    posts.length === 0 ? (
      <p class="empty-state">还没有公开文章。新建 <code>content/posts/*.md</code> 并提交即可发布。</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <h2><a href={post.data.path}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="meta">
              <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
              {post.data.categories.length > 0 && <span>{post.data.categories.join(" / ")}</span>}
            </div>
          </li>
        ))}
      </ul>
    )
  }
  {
    categories.length > 0 && (
      <ul class="taxonomy" aria-label="分类">
        {categories.map((category) => (
          <li><a href={`/categories/${encodeURIComponent(category)}/`}>{category}</a></li>
        ))}
      </ul>
    )
  }
  <aside class="lab-callout">
    <p>三维档案入口：<a href="/lab/">打开 RHINE LAB 分析终端</a>。普通文章阅读不会加载 Three.js、GLB 或背景音乐。</p>
  </aside>
</BaseLayout>
