---
import "../styles/blog.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  ogType = "website",
  ogImage,
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;
const site = Astro.site ?? new URL("https://example.com");
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site);
const rssUrl = new URL("/rss.xml", site).href;
const fullTitle = title === "示例博客" ? title : `${title} · 示例博客`;
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="示例博客" href={rssUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="示例博客" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="site-brand" href="/">示例博客</a>
      <nav class="site-nav" aria-label="站点导航">
        <a href="/archive/">归档</a>
        <a href="/categories/">分类</a>
        <a href="/tags/">标签</a>
        <a href="/search/">搜索</a>
        <a href="/rss.xml">RSS</a>
        <a href="/lab/">三维档案</a>
        <!-- 账号入口：无 JS 时是普通链接；有 JS 时显示当前用户名，
             与 /lab/ 共用同一个 __Host-lab-session Cookie。 -->
        <a class="account-link" href="/account/" data-account-link data-account-state="signed-out">登录</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getUTCFullYear()} Joyce · 由 Markdown 与 Astro 生成</p>
    <!-- 备案信息（按需填写）：若站点在中国大陆备案，可在此处放回工信部备案号与公安备案号。
         本模板默认不包含任何备案号与备案图标。 -->
    </footer>
    <script>
      // 账号岛：页头控件与 /account/ 表单共用一份实现。文章正文在不加载它时依然完整可读。
      import "../scripts/account";
    </script>
  </body>
</html>
